@page "/administration/bible"
@page "/admin/versets"
@attribute [Authorize]
@using ChandorAdmin.Components.Bible
@using ChandorProject.Shared.DTOs.Bible
@using Syncfusion.Blazor.Popups
@implements IDisposable

<PageTitle>Versets bibliques</PageTitle>

<div class="bible-admin-page">
    <header class="bible-admin-header">
        <div><div class="bible-admin-eyebrow">Administration</div><h1>Versets bibliques</h1><p>Programmez le verset et la pensée publiés chaque jour.</p></div>
        <div class="bible-admin-header-actions"><button type="button" class="secondary" disabled="@(_loading || _saving)" @onclick="LoadPageAsync">Actualiser</button><button type="button" class="primary" disabled="@(_loading || _saving)" @onclick="OpenCreate">Nouveau verset</button></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="bible-admin-notice @(_noticeIsError ? "error" : "success")" role="alert"><span>@_notice</span><button type="button" @onclick="() => _notice = null">×</button></div>
    }
    @if (_loading)
    {
        <div class="bible-admin-loading" role="status"><span></span> Chargement…</div>
    }

    <section class="bible-admin-surface">
        <div class="bible-admin-summary"><div><span>Total</span><strong>@_page.TotalCount</strong></div><div><span>Page actuelle</span><strong>@DisplayPage / @Math.Max(1, _page.TotalPages)</strong></div><div><span>Éléments par page</span><select @bind="_pageSize" @bind:after="ChangePageSizeAsync" disabled="@_loading"><option value="10">10</option><option value="20">20</option><option value="50">50</option></select></div></div>
        <BibleVerseGrid Items="_page.Items" Disabled="@(_loading || _saving)" View="OpenDetailAsync" Edit="OpenEditAsync" Delete="DeleteAsync" />
        <div class="bible-admin-pagination"><span>@_page.TotalCount verset(s)</span><div><button type="button" disabled="@(!_page.HasPreviousPage || _loading)" @onclick="() => ChangePageAsync(_page.Page - 1)">Précédent</button><span>Page @DisplayPage sur @Math.Max(1, _page.TotalPages)</span><button type="button" disabled="@(!_page.HasNextPage || _loading)" @onclick="() => ChangePageAsync(_page.Page + 1)">Suivant</button></div></div>
    </section>
</div>

@if (_dialogOpen)
{
    <SfDialog @bind-Visible="_dialogOpen" IsModal="true" Width="@(_dialogKind == "DETAIL" ? "min(760px, 96vw)" : "min(720px, 96vw)")" Header="@_dialogTitle" ShowCloseIcon="false" CloseOnEscape="false" CssClass="bible-admin-dialog">
        <DialogTemplates><Content>
            @if (_dialogKind == "DETAIL" && _selectedVerse is not null)
            {
                <BibleVerseCard Verse="_selectedVerse" />
                <dl class="bible-admin-detail-meta"><dt>Créé le</dt><dd>@LocalDate(_selectedVerse.Created)</dd><dt>Modifié le</dt><dd>@LocalDate(_selectedVerse.Updated)</dd></dl>
                <div class="bible-detail-actions"><button type="button" @onclick="CloseDialog">Fermer</button><button type="button" class="primary" @onclick="() => BeginEdit(_selectedVerse)">Modifier</button></div>
            }
            else
            {
                <BibleVerseForm @key="_formModel" Model="_formModel" IsSubmitting="_saving" FormName="@($"bible-{_dialogKind.ToLowerInvariant()}")" OnValidSubmit="SaveAsync" Cancel="CloseDialog" />
                @if (!string.IsNullOrWhiteSpace(_dialogError)) { <div class="bible-dialog-error" role="alert">@_dialogError</div> }
            }
        </Content></DialogTemplates>
    </SfDialog>
}

@code {
    private int DisplayPage => _page.Page <= 0 ? 1 : _page.Page;
}
