@page "/administration/bible"
@page "/admin/versets"
@attribute [Authorize]
@using ChandorAdmin.Components.Bible
@using ChandorProject.Shared.DTOs.Bible
@using Syncfusion.Blazor.Popups
@implements IDisposable

<PageTitle>Versets bibliques</PageTitle>

<div class="dashboard-page bible-admin-page">
    <DashboardHeader Title="Versets bibliques"
                     Subtitle="Programmez le verset et la pensée publiés chaque jour."
                     Eyebrow="Gestion">
        <HeaderActions>
            <SfButton Disabled="@(_loading || _saving)" OnClick="LoadPageAsync">Actualiser</SfButton>
            <SfButton IsPrimary="true" Disabled="@(_loading || _saving)" OnClick="OpenCreate">Nouveau verset</SfButton>
        </HeaderActions>
    </DashboardHeader>

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="bible-admin-notice @(_noticeIsError ? "error" : "success")" role="alert"><span>@_notice</span><button type="button" @onclick="() => _notice = null">×</button></div>
    }
    @if (_loading)
    {
        <div class="bible-admin-loading" role="status"><span></span> Chargement…</div>
    }

    <section class="bible-admin-surface">
        <div class="bible-admin-summary"><div><span>Total</span><strong>@_page.TotalCount</strong></div><div><span>Page actuelle</span><strong>@DisplayPage / @Math.Max(1, _page.TotalPages)</strong></div><div><span>Éléments par page</span><SfDropDownList TValue="int" TItem="int" DataSource="@_pageSizes" Value="@_pageSize" ValueChanged="OnPageSizeChanged" Enabled="@(!_loading)" Width="110px" /></div></div>
        <BibleVerseGrid Items="_page.Items" Disabled="@(_loading || _saving)" View="OpenDetailAsync" Edit="OpenEditAsync" Delete="DeleteAsync" />
        <div class="bible-admin-pagination"><span>@_page.TotalCount verset(s)</span><div><SfButton Disabled="@(!_page.HasPreviousPage || _loading)" OnClick="@(() => ChangePageAsync(_page.Page - 1))">Précédent</SfButton><span>Page @DisplayPage sur @Math.Max(1, _page.TotalPages)</span><SfButton Disabled="@(!_page.HasNextPage || _loading)" OnClick="@(() => ChangePageAsync(_page.Page + 1))">Suivant</SfButton></div></div>
    </section>
</div>

@if (_dialogOpen)
{
    <SfDialog @bind-Visible="_dialogOpen" IsModal="true" Width="@(_dialogKind == "DETAIL" ? "min(760px, 96vw)" : "min(720px, 96vw)")" Header="@_dialogTitle" ShowCloseIcon="false" CloseOnEscape="false" CssClass="bible-admin-dialog">
        <DialogTemplates><Content>
            @if (_dialogKind == "DETAIL" && _selectedVerse is not null)
            {
                <BibleVerseCard Verse="_selectedVerse" />
                <dl class="bible-admin-detail-meta"><dt>Créé le</dt><dd>@LocalDate(_selectedVerse.Created)</dd><dt>Modifié le</dt><dd>@LocalDate(_selectedVerse.Updated)</dd></dl>
                <div class="bible-detail-actions"><SfButton OnClick="CloseDialog">Fermer</SfButton><SfButton IsPrimary="true" OnClick="@(() => BeginEdit(_selectedVerse))">Modifier</SfButton></div>
            }
            else
            {
                <BibleVerseForm @key="_formModel" Model="_formModel" IsSubmitting="_saving" FormName="@($"bible-{_dialogKind.ToLowerInvariant()}")" OnValidSubmit="SaveAsync" Cancel="CloseDialog" />
                @if (!string.IsNullOrWhiteSpace(_dialogError)) { <div class="bible-dialog-error" role="alert">@_dialogError</div> }
            }
        </Content></DialogTemplates>
    </SfDialog>
}

@code {
    private int DisplayPage => _page.Page <= 0 ? 1 : _page.Page;
}
