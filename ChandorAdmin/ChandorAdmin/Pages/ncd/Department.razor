@page "/department/{departmentId:guid}"
@using ChandorAdmin.Components.DepartmentManagement
@using ChandorAdmin.Components.GlobalNotification
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Spinner

<PageTitle>@PageTitleText</PageTitle>

<HeadContent>
    <link href="css/finance-transactions.css" rel="stylesheet" />
</HeadContent>

@if (_invalidDepartmentId)
{
    <div class="alert alert-warning m-3" role="alert">
        Invalid department: the identifier is missing or not a valid GUID.
    </div>
}
else if (_pageLoading)
{
    <div class="d-flex flex-column align-items-center justify-content-center gap-3 p-5" aria-busy="true" aria-live="polite">
        <SfSpinner Visible="true" Type="SpinnerType.Material" Label="Loading department…" />
    </div>
}
else if (_pageError is not null)
{
    <div class="alert alert-danger m-3" role="alert">
        @_pageError
    </div>
}
else
{
    <div id="et-transactions-host" class="expense-page transactions-page-root">

        <div class="exp-content-container transactions-main-pane">
            <div class="transactions-body">
                <div class="col-md-12 margin-top col-lg-12 transactions-grid-column">
                    <div class="expense-grid-container">
                        <div class="expense-head-padding" style="background-color: @_searchHeadBg;">
                            <div class="search-wrapper search-section" style="display: @_searchVisibility;">
                                <div class="toolbar-type">
                                    <SfDropDownList TValue="string"
                                                    TItem="GenderFilterOption"
                                                    DataSource="@_genderOptions"
                                                    Width="140px"
                                                    CssClass="et-type-filter"
                                                    Value="@_selectedGenderValue"
                                                    ValueChanged="OnToolbarGenderChanged"
                                                    Placeholder="Genre">
                                        <DropDownListFieldSettings Text="Name" Value="Value"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                </div>
                                <div id="search">
                                    <SfTextBox Type="InputType.Search"
                                               ShowClearButton="true"
                                               Placeholder="Recherche"
                                               @bind-Value="@_searchValue"
                                               ValueChange="OnSearchChanged"
                                               Created="OnSearchCreated"
                                               CssClass="search txt">
                                    </SfTextBox>
                                    <span id="searchbtn" class="e-search-icon expense-search-icon e-icons" @onclick="RunSearchAsync"></span>
                                </div>
                                <div class="button-section search-section">
                                    <SfButton id="addexpense" OnClick="OpenAddDialogAsync" IsPrimary="true">Ajouter</SfButton>
                                    <SfButton id="filterExpense" OnClick="OpenFilterMenu">Filter</SfButton>
                                    <SfButton id="add-btn" IsPrimary="true" OnClick="OpenAddDialogAsync" IconCss="e-icons add-icon add-head-item"></SfButton>
                                    <SfButton id="filter-btn" OnClick="OpenFilterMenu" IconCss="e-icons e-filter"></SfButton>
                                </div>
                            </div>
                        </div>
                        <!-- DepartmentMemberGridPanel -->
                        <DepartmentMemberGridPanel @ref="_gridRef" DepartmentId="DepartmentId" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Department Member Filter Sidebar -->
        <DepartmentMemberFilterSidebar @ref="_filterRef"
                                       DepartmentId="DepartmentId"
                                       DepartmentName="@_department?.Name" />

        <!-- Add Member Dialog -->
        <DepartmentMemberAddDialog @ref="_dialogRef" />

        <!-- Notification -->
        <NotificationDialog @ref="_notificationRef" />

    </div>
}
