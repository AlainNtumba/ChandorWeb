@page "/church-directory-management"
@using ChandorAdmin.Components.ChurchDirectory
@using ChandorProject.Shared.DTOs.ChurchDirectory
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@implements IDisposable

<PageTitle>Annuaire de l’église</PageTitle>

<div class="dashboard-page directory-page">
    <DashboardHeader Title="Annuaire de l’église"
                     Subtitle="Gestion structurelle et organisationnelle de l'Église"
                     Eyebrow="Gestion">
        <HeaderActions>
            <SfButton OnClick="RefreshSelectedAsync" Disabled="@_loading">Actualiser</SfButton>
            @if (_selectedTab < 2)
            {
                <SfButton IsPrimary="true" OnClick="OpenNewDialog" Disabled="@_loading">@(_selectedTab == 0 ? "Nouveau type" : "Nouvel élément")</SfButton>
            }
        </HeaderActions>
    </DashboardHeader>

    @if (!string.IsNullOrWhiteSpace(_notice)) { <div class="directory-notice @(_noticeIsError ? "error" : "success")" role="alert"><span>@_notice</span><button type="button" @onclick="() => _notice = null">×</button></div> }
    @if (_loading) { <div class="directory-loading"><span></span> Chargement…</div> }

    <section class="directory-surface">
        <ChandorTabs CssClass="directory-tabs" @bind-SelectedItem="_selectedTab" @bind-SelectedItem:after="OnSelectedTabChangedAsync">
            <TabItems>
                <TabItem><HeaderTemplate><ChandorTabHeader Text="Types" IconCss="e-icons e-list-unordered" BadgeCount="_typePage.TotalCount" /></HeaderTemplate><ContentTemplate>
                    <div class="directory-tab-content">
                        <div class="admin-filters">
                            <div class="admin-filters__search">
                                <SfTextBox Type="InputType.Search" ShowClearButton="true" Placeholder="Rechercher un type…" Value="@_typeFilter.Keyword" Input="OnTypeKeywordAsync" />
                            </div>
                            <div class="admin-filters__dropdowns">
                                <SfDropDownList TValue="bool?" TItem="ActiveChoice" DataSource="@ActiveChoices" Value="@_typeFilter.IsActive" ValueChanged="OnTypeActiveChanged" Placeholder="Tous les statuts"><DropDownListFieldSettings Text="Text" Value="Value" /></SfDropDownList>
                            </div>
                        </div>
                        <DirectoryTypeGrid Items="_typePage.Items" Edit="EditType" Delete="DeleteTypeAsync" />
                        @Pagination("TYPE", _typePage.Page, _typePage.TotalPages, _typePage.TotalCount)
                    </div>
                </ContentTemplate></TabItem>
                <TabItem><HeaderTemplate><ChandorTabHeader Text="Éléments" IconCss="e-icons e-table" BadgeCount="_itemPage.TotalCount" /></HeaderTemplate><ContentTemplate>
                    <div class="directory-tab-content">
                        <div class="admin-filters">
                            <div class="admin-filters__search">
                                <SfTextBox Type="InputType.Search" ShowClearButton="true" Placeholder="Rechercher un élément…" Value="@_itemFilter.Keyword" Input="OnItemKeywordAsync" />
                            </div>
                            <div class="admin-filters__dropdowns">
                                <SfDropDownList TValue="Guid?" TItem="ChurchDirectoryTypeDto" DataSource="@_types" Value="@_itemFilter.TypeId" ValueChanged="OnItemTypeChanged" Placeholder="Tous les types" AllowFiltering="true" ShowClearButton="true"><DropDownListFieldSettings Text="Name" Value="Id" /></SfDropDownList>
                                <SfDropDownList TValue="bool?" TItem="ActiveChoice" DataSource="@ActiveChoices" Value="@_itemFilter.IsActive" ValueChanged="OnItemActiveChanged" Placeholder="Tous les statuts"><DropDownListFieldSettings Text="Text" Value="Value" /></SfDropDownList>
                                <SfDropDownList TValue="Guid?" TItem="ChurchDirectoryItemDto" DataSource="@ParentFilterOptions" Value="@_itemFilter.ParentId" ValueChanged="OnItemParentChanged" Placeholder="Tous les parents" AllowFiltering="true" ShowClearButton="true"><DropDownListFieldSettings Text="Name" Value="Id" /></SfDropDownList>
                            </div>
                        </div>
                        <DirectoryItemGrid Items="_itemPage.Items" Edit="EditItem" Delete="DeleteItemAsync" />
                        @Pagination("ITEM", _itemPage.Page, _itemPage.TotalPages, _itemPage.TotalCount)
                    </div>
                </ContentTemplate></TabItem>
                <TabItem><HeaderTemplate><ChandorTabHeader Text="Hiérarchie" IconCss="e-icons e-people" BadgeCount="_tree.Count" BadgeTone="neutral" /></HeaderTemplate><ContentTemplate>
                    <div class="directory-tab-content"><div class="admin-filters"><div class="admin-filters__dropdowns"><SfDropDownList TValue="Guid" TItem="ChurchDirectoryTypeDto" DataSource="@_types" Value="@_treeTypeId" ValueChanged="OnTreeTypeChanged" Placeholder="Sélectionnez un type" AllowFiltering="true"><DropDownListFieldSettings Text="Name" Value="Id" /></SfDropDownList></div></div>
                    @if (_treeTypeId == Guid.Empty) { <div class="directory-empty">Sélectionnez un type.</div> } else if (_tree.Count == 0) { <div class="directory-empty">Aucun élément dans cette hiérarchie.</div> } else { <DirectoryTreeView Nodes="_tree" Edit="EditItem" AddChild="AddTreeChild" /> }</div>
                </ContentTemplate></TabItem>
                <TabItem><HeaderTemplate><ChandorTabHeader Text="Prévisualisation" IconCss="e-icons e-eye" /></HeaderTemplate><ContentTemplate>
                    <div class="directory-tab-content"><div class="admin-filters"><div class="admin-filters__row"><div class="admin-filters__dropdowns"><SfDropDownList TValue="Guid" TItem="ChurchDirectoryTypeDto" DataSource="@_publicTypes" Value="@_previewTypeId" ValueChanged="OnPreviewTypeChanged" Placeholder="Sélectionnez un type" AllowFiltering="true"><DropDownListFieldSettings Text="Name" Value="Id" /></SfDropDownList></div><span class="directory-public-label">Données provenant uniquement des routes publiques</span></div></div><DirectoryPublicPreview DirectoryType="PreviewType" Items="_publicItems" Open="OpenPreviewDetail" /></div>
                </ContentTemplate></TabItem>
            </TabItems>
        </ChandorTabs>
    </section>
</div>

@if (_dialogOpen)
{
    <SfDialog @bind-Visible="_dialogOpen" IsModal="true" Width="@(_dialogKind == "TYPE" ? "min(600px, 96vw)" : "min(900px, calc(100vw - 24px))")" Header="@_dialogTitle" ShowCloseIcon="false" CloseOnEscape="false" CssClass="directory-dialog">
        <DialogTemplates><Content>
            @if (_dialogKind == "TYPE")
            {
                <div class="directory-form-grid">
                    @if (!_editingId.HasValue) { <label><span>Code *</span><input @bind="_typeModel.Code" placeholder="CELL" /></label> }
                    <label><span>Nom *</span><input @bind="_typeModel.Name" /></label>
                    <label><span>Affichage *</span><select @bind="_typeModel.DisplayKind">@foreach (var kind in DisplayKinds) { <option value="@kind">@kind</option> }</select></label>
                    <label class="span-2"><span>Description</span><textarea rows="4" @bind="_typeModel.Description"></textarea></label><label><span>Ordre</span><input type="number" @bind="_typeModel.SortOrder" /></label><label class="directory-check"><input type="checkbox" @bind="_typeModel.IsActive" /> Type actif</label>
                </div>
                <h4 class="directory-section-title">Image Hero</h4><DirectoryImagePicker ExistingImageUrl="_typeModel.HeroImageUrl" @bind-SelectedImage="_selectedImage" @bind-DeleteRequested="_deleteImage" />
            }
            else if (_dialogKind == "ITEM")
            {
                <div class="directory-subtabs"><button type="button" class='@SubTab("GENERAL")' @onclick='() => _itemSubTab = "GENERAL"'>Général</button><button type="button" class='@SubTab("DETAILS")' @onclick='() => _itemSubTab = "DETAILS"'>Détails</button><button type="button" class='@SubTab("CONTACTS")' @onclick='() => _itemSubTab = "CONTACTS"'>Contacts</button><button type="button" class='@SubTab("MEMBERS")' @onclick='() => _itemSubTab = "MEMBERS"'>Responsables</button><button type="button" class='@SubTab("IMAGE")' @onclick='() => _itemSubTab = "IMAGE"'>Image</button></div>
                @if (_itemSubTab == "GENERAL")
                {
                    <div class="directory-form-grid">
                        <label><span>Type *</span><select value="@_itemModel.TypeId" @onchange="OnItemTypeChanged"><option value="@Guid.Empty">Sélectionnez</option>@foreach (var type in _types) { <option value="@type.Id">@type.Name</option> }</select></label>
                        <label><span>Parent</span><select @bind="_itemModel.ParentId"><option value="">Aucun parent</option>@foreach (var item in ParentOptions) { <option value="@item.Id">@item.Name</option> }</select></label>
                        <label><span>Département associé</span><select @bind="_itemModel.DepartmentId"><option value="">Aucun département</option>@foreach (var department in _departments) { <option value="@department.Id">@department.Name</option> }</select></label>
                        @if (!_editingId.HasValue) { <label><span>Code *</span><input @bind="_itemModel.Code" /></label> }
                        <label><span>Nom *</span><input @bind="_itemModel.Name" /></label><label><span>Ordre</span><input type="number" @bind="_itemModel.SortOrder" /></label>
                        <label class="span-2"><span>Description</span><textarea rows="4" @bind="_itemModel.Description"></textarea></label><label class="directory-check"><input type="checkbox" @bind="_itemModel.IsActive" /> Élément actif</label>
                    </div>
                }
                else if (_itemSubTab == "DETAILS")
                {
                    <div class="directory-detail-heading">Affichage <strong>@CurrentDisplayKind</strong></div>
                    <div class="directory-form-grid">
                    @if (CurrentDisplayKind == "LOCATION" && _itemModel.LocationDetails is not null)
                    { <label><span>Zone</span><input @bind="_itemModel.LocationDetails.Area" /></label><label><span>Adresse</span><input @bind="_itemModel.LocationDetails.Address" /></label><label class="span-2"><span>Point de repère</span><input @bind="_itemModel.LocationDetails.ReferencePoint" /></label><label><span>Latitude</span><input type="number" step="any" @bind="_itemModel.LocationDetails.Latitude" /></label><label><span>Longitude</span><input type="number" step="any" @bind="_itemModel.LocationDetails.Longitude" /></label> }
                    else if (_itemModel.DepartmentDetails is not null)
                    { <label class="span-2"><span>Organisation</span><textarea rows="3" @bind="_itemModel.DepartmentDetails.Organization"></textarea></label><label class="span-2"><span>Mission</span><textarea rows="3" @bind="_itemModel.DepartmentDetails.Mission"></textarea></label><label class="span-2"><span>Historique</span><textarea rows="4" @bind="_itemModel.DepartmentDetails.History"></textarea></label> }
                    else { <div class="directory-empty span-2">Sélectionnez d’abord un type dans l’onglet Général.</div> }
                    </div>
                }
                else if (_itemSubTab == "CONTACTS") { <DirectoryContactsEditor Contacts="_itemModel.Contacts" /> }
                else if (_itemSubTab == "MEMBERS") { <DirectoryMembersEditor Members="_itemModel.Members" AllMembers="_members" /> }
                else { <DirectoryImagePicker ExistingImageUrl="_itemModel.ImageUrl" @bind-SelectedImage="_selectedImage" @bind-DeleteRequested="_deleteImage" /> }
            }
            else if (_dialogKind == "PREVIEW" && _previewDetail is not null)
            {
                <article class="directory-preview-detail">@if (!string.IsNullOrWhiteSpace(_previewDetail.ImageUrl)) { <img src="@_previewDetail.ImageUrl" alt="@_previewDetail.Name" /> }<p>@_previewDetail.Description</p>
                    @if (_previewDetail.DisplayKind == "LOCATION") { <dl><dt>Zone</dt><dd>@(_previewDetail.LocationDetails?.Area ?? "—")</dd><dt>Adresse</dt><dd>@(_previewDetail.LocationDetails?.Address ?? "—")</dd><dt>Repère</dt><dd>@(_previewDetail.LocationDetails?.ReferencePoint ?? "—")</dd></dl> }
                    else { <dl><dt>Organisation</dt><dd>@(_previewDetail.DepartmentDetails?.Organization ?? "—")</dd><dt>Mission</dt><dd>@(_previewDetail.DepartmentDetails?.Mission ?? "—")</dd><dt>Historique</dt><dd>@(_previewDetail.DepartmentDetails?.History ?? "—")</dd></dl> }
                </article>
            }
        </Content></DialogTemplates>
        <DialogButtons>@if (_dialogKind != "PREVIEW") { <DialogButton Content="@(_saving ? "Chargement..." : "Enregistrer")" IsPrimary="true" Disabled="@_saving" OnClick="SaveDialogAsync" /> }<DialogButton Content="Fermer" Disabled="@_saving" OnClick="CloseDialog" /></DialogButtons>
    </SfDialog>
}

@code {
    private RenderFragment Pagination(string target, int page, int totalPages, int totalCount) => @<div class="directory-pagination"><span>@totalCount résultat(s)</span><div><button type="button" disabled="@(page <= 1 || _loading)" @onclick="() => ChangePageAsync(target, page - 1)">Précédent</button><span>Page @(page == 0 ? 1 : page) / @Math.Max(1, totalPages)</span><button type="button" disabled="@(page >= totalPages || _loading)" @onclick="() => ChangePageAsync(target, page + 1)">Suivant</button></div></div>;
    private string SubTab(string value) => _itemSubTab == value ? "active" : string.Empty;
}
