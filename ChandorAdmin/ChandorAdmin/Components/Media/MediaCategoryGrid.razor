@using ChandorProject.Shared.DTOs.Media

<div class="media-table-wrap">
    <table class="media-table">
        <thead><tr><th>Nom</th><th>Code</th><th>Module</th><th>Collections</th><th>Contenus</th><th>Ordre</th><th>Actif</th><th>Actions</th></tr></thead>
        <tbody>
        @if (Items.Count == 0)
        {
            <tr><td colspan="8" class="media-empty">Aucune catégorie.</td></tr>
        }
        @foreach (var item in Items)
        {
            <tr>
                <td class="media-strong">@item.Name</td><td><code>@item.Code</code></td><td>@item.ModuleType</td>
                <td>@item.CollectionCount</td><td>@item.ItemCount</td><td>@item.SortOrder</td>
                <td><span class="media-status @(item.IsActive ? "media-status--published" : "media-status--draft")">@(item.IsActive ? "Oui" : "Non")</span></td>
                <td class="media-actions"><button type="button" @onclick="() => Edit.InvokeAsync(item)">Modifier</button><button type="button" class="danger" @onclick="() => Delete.InvokeAsync(item)">Supprimer</button></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IReadOnlyList<MediaCategoryDto> Items { get; set; } = [];
    [Parameter] public EventCallback<MediaCategoryDto> Edit { get; set; }
    [Parameter] public EventCallback<MediaCategoryDto> Delete { get; set; }
}
