@using ChandorProject.Shared.DTOs.Media

<SfGrid TValue="MediaCategoryDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="media-empty">Aucune catégorie.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(MediaCategoryDto.Name)" HeaderText="Nom" />
        <GridColumn Field="@nameof(MediaCategoryDto.Code)" HeaderText="Code" Width="140" />
        <GridColumn Field="@nameof(MediaCategoryDto.ModuleType)" HeaderText="Module" Width="140" />
        <GridColumn Field="@nameof(MediaCategoryDto.CollectionCount)" HeaderText="Collections" Width="130" />
        <GridColumn Field="@nameof(MediaCategoryDto.ItemCount)" HeaderText="Contenus" Width="120" />
        <GridColumn Field="@nameof(MediaCategoryDto.SortOrder)" HeaderText="Ordre" Width="90" />
        <GridColumn HeaderText="Actif" Width="110">
            <Template>
                @{ var item = context as MediaCategoryDto; }
                @if (item is not null)
                {
                    <span class="media-status @(item.IsActive ? "media-status--published" : "media-status--draft")">@(item.IsActive ? "Oui" : "Non")</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="220">
            <Template>
                @{ var item = context as MediaCategoryDto; }
                @if (item is not null)
                {
                    <div class="media-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<MediaCategoryDto> Items { get; set; } = [];
    [Parameter] public EventCallback<MediaCategoryDto> Edit { get; set; }
    [Parameter] public EventCallback<MediaCategoryDto> Delete { get; set; }
}
