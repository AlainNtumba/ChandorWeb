@using ChandorProject.Shared.DTOs.Media

<SfGrid TValue="MediaCollectionDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="media-empty">Aucune collection.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(MediaCollectionDto.Title)" HeaderText="Titre" />
        <GridColumn Field="@nameof(MediaCollectionDto.CategoryCode)" HeaderText="Catégorie" Width="140" />
        <GridColumn HeaderText="Statut" Width="130">
            <Template>
                @{ var item = context as MediaCollectionDto; }
                @if (item is not null)
                {
                    <span class="media-status @StatusClass(item.Status)">@item.Status</span>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(MediaCollectionDto.ItemCount)" HeaderText="Contenus" Width="110" />
        <GridColumn HeaderText="Médias" Width="100">
            <Template>
                @{ var item = context as MediaCollectionDto; }
                @(item?.Media.Count)
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Publication" Width="170">
            <Template>
                @{ var item = context as MediaCollectionDto; }
                @(item is null ? null : item.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(MediaCollectionDto.SortOrder)" HeaderText="Ordre" Width="90" />
        <GridColumn HeaderText="Actions" Width="280">
            <Template>
                @{ var item = context as MediaCollectionDto; }
                @if (item is not null)
                {
                    <div class="media-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton OnClick="@(() => Attach.InvokeAsync(item))">Médias</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<MediaCollectionDto> Items { get; set; } = [];
    [Parameter] public EventCallback<MediaCollectionDto> Edit { get; set; }
    [Parameter] public EventCallback<MediaCollectionDto> Attach { get; set; }
    [Parameter] public EventCallback<MediaCollectionDto> Delete { get; set; }
    private static string StatusClass(string status) => $"media-status--{status.ToLowerInvariant()}";
}
