@using ChandorProject.Shared.DTOs.Media

<SfGrid TValue="ContentItemDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="media-empty">Aucun contenu.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(ContentItemDto.Title)" HeaderText="Titre" />
        <GridColumn Field="@nameof(ContentItemDto.ItemType)" HeaderText="Type" Width="120" />
        <GridColumn Field="@nameof(ContentItemDto.CategoryCode)" HeaderText="Catégorie" Width="140" />
        <GridColumn HeaderText="Collection" Width="160">
            <Template>
                @{ var item = context as ContentItemDto; }
                @(item is null ? null : item.CollectionTitle ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Statut" Width="130">
            <Template>
                @{ var item = context as ContentItemDto; }
                @if (item is not null)
                {
                    <span class="media-status @StatusClass(item.Status)">@item.Status</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Médias" Width="100">
            <Template>
                @{ var item = context as ContentItemDto; }
                @(item?.Media.Count)
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(ContentItemDto.SortOrder)" HeaderText="Ordre" Width="90" />
        <GridColumn HeaderText="Actions" Width="280">
            <Template>
                @{ var item = context as ContentItemDto; }
                @if (item is not null)
                {
                    <div class="media-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton OnClick="@(() => Attach.InvokeAsync(item))">Médias</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<ContentItemDto> Items { get; set; } = [];
    [Parameter] public EventCallback<ContentItemDto> Edit { get; set; }
    [Parameter] public EventCallback<ContentItemDto> Attach { get; set; }
    [Parameter] public EventCallback<ContentItemDto> Delete { get; set; }
    private static string StatusClass(string status) => $"media-status--{status.ToLowerInvariant()}";
}
