@using ChandorProject.Shared.DTOs.Media

<SfGrid TValue="MediaAssetDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="media-empty">Aucun média.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn HeaderText="Aperçu" Width="100">
            <Template>
                @{ var item = context as MediaAssetDto; }
                @if (item is not null)
                {
                    @if (item.AssetType == "IMAGE" && !string.IsNullOrWhiteSpace(item.Url))
                    {
                        <img class="media-thumb" src="@item.Url" alt="Aperçu" />
                    }
                    else if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                    {
                        <img class="media-thumb" src="@item.ThumbnailUrl" alt="Aperçu" />
                    }
                    else
                    {
                        <span class="media-file-icon">@TypeIcon(item.AssetType)</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(MediaAssetDto.AssetType)" HeaderText="Type" Width="120" />
        <GridColumn Field="@nameof(MediaAssetDto.Provider)" HeaderText="Provider" Width="140" />
        <GridColumn HeaderText="URL">
            <Template>
                @{ var item = context as MediaAssetDto; }
                @if (item is not null)
                {
                    <span class="media-url"><a href="@item.Url" target="_blank" rel="noopener">@item.Url</a></span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="MIME" Width="140">
            <Template>
                @{ var item = context as MediaAssetDto; }
                @(item is null ? null : item.MimeType ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Durée" Width="110">
            <Template>
                @{ var item = context as MediaAssetDto; }
                @(item is null ? null : Duration(item.DurationSeconds))
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="220">
            <Template>
                @{ var item = context as MediaAssetDto; }
                @if (item is not null)
                {
                    <div class="media-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<MediaAssetDto> Items { get; set; } = [];
    [Parameter] public EventCallback<MediaAssetDto> Edit { get; set; }
    [Parameter] public EventCallback<MediaAssetDto> Delete { get; set; }
    private static string TypeIcon(string type) => type switch { "VIDEO" => "▶", "AUDIO" => "♪", "DOCUMENT" => "PDF", _ => "◆" };
    private static string Duration(int? seconds) => seconds is null ? "—" : TimeSpan.FromSeconds(seconds.Value).ToString(@"hh\:mm\:ss");
}
