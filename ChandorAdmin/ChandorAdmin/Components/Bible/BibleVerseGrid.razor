@using ChandorProject.Shared.DTOs.Bible

<SfGrid TValue="BibleVerseDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="bible-empty">Aucun verset enregistré.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn HeaderText="Date" Width="130">
            <Template>
                @{ var item = context as BibleVerseDto; }
                @if (item is not null)
                {
                    <time datetime="@item.PublicationDate.ToString("yyyy-MM-dd")">@item.PublicationDate.ToString("dd/MM/yyyy")</time>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Référence" Width="160">
            <Template>
                @{ var item = context as BibleVerseDto; }
                @if (item is not null)
                {
                    <strong>@Reference(item)</strong>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Contenu">
            <Template>
                @{ var item = context as BibleVerseDto; }
                @if (item is not null)
                {
                    <div class="bible-preview">@Preview(item.Content, 95)</div>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Pensée du jour">
            <Template>
                @{ var item = context as BibleVerseDto; }
                @if (item is not null)
                {
                    <div class="bible-preview">@Preview(item.DailyThought, 75)</div>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="280" AllowSorting="false">
            <Template>
                @{ var item = context as BibleVerseDto; }
                @if (item is not null)
                {
                    <div class="bible-actions">
                        <SfButton Disabled="@Disabled" OnClick="@(() => View.InvokeAsync(item))">Voir</SfButton>
                        <SfButton Disabled="@Disabled" OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton CssClass="danger" Disabled="@Disabled" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<BibleVerseDto> Items { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<BibleVerseDto> View { get; set; }
    [Parameter] public EventCallback<BibleVerseDto> Edit { get; set; }
    [Parameter] public EventCallback<BibleVerseDto> Delete { get; set; }

    private static string Reference(BibleVerseDto item) => string.IsNullOrWhiteSpace(item.Reference) ? $"{item.BookName} {item.Chapter}:{item.Verse}" : item.Reference;
    private static string Preview(string value, int length) => value.Length <= length ? value : $"{value[..(length - 1)]}…";
}
