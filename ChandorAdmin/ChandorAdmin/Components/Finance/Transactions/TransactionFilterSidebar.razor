@using ChandorAdmin.Components.Dashboard
@using ChandorAdmin.Components.Finance.Management
@using ChandorAdmin.Helpers
@using ChandorAdmin.Interfaces.Api
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using ChandorProject.Shared.DTOs.Currency
@using ChandorProject.Shared.DTOs.Transaction
@inject ICurrencyService CurrencyService;

<div class="transactions-filter-root">
    <span id="filter-toggle"
          class="navbar-toggle e-icons e-filter"
          role="button"
          tabindex="0"
          aria-label="Open filters"
          @onclick="ShowFilterMenu"
          @onkeydown="OnFilterToggleKey"></span>

    @if (_mobileDrawerOpen)
    {
        <div class="overlay" @onclick="HideFilterMenu"></div>
    }

    <aside class="transactions-filter-dock @(_mobileDrawerOpen ? "transactions-filter-dock--open" : null)" aria-label="Transaction filters">
        <div class="sidebar-wrapper-filter">
            <div class="filter-head">
                <span class="e-icon filter-icon filter-head-item"></span>
                <span class="filter-txt filter-head-item">Opérations Financières</span>
            </div>
            <div class="expense-filter-container">
                <label class="label-font">Sélectionnez une période</label>
                <div class="filter-date-range filter-item">
                    <SfDateRangePicker TValue="DateTime"
                                       CssClass="DateTime"
                                       ShowClearButton="false"
                                       Format="MM/dd/yyyy"
                                       AllowEdit="false"
                                       EndDate="@EndDate"
                                       StartDate="@StartDate"
                                       Min="@_pickerMinDate"
                                       Max="@_pickerMaxDate"
                                       Presets="@_transactionDateRangePresets">
                        <DateRangePickerEvents TValue="DateTime" ValueChange="DateRangeChanged"></DateRangePickerEvents>
                    </SfDateRangePicker>
                </div>
                <label class="label-font">Devise</label>
                <div class="filter-item">
                    <SfDropDownList TValue="Guid?"
                                    TItem="CurrencyDto"
                                    DataSource="@_currencies"
                                    Placeholder="Toutes les devises"
                                    ShowClearButton="true"
                                    AllowFiltering="true"
                                    Width="100%"
                                    Value="@CurrencyId">
                        <DropDownListFieldSettings Text="Name" Value="Id"></DropDownListFieldSettings>
                        <DropDownListEvents TValue="Guid?" TItem="CurrencyDto" ValueChange="OnCurrencyChanged"></DropDownListEvents>
                    </SfDropDownList>
                </div>
                <label class="label-font">Catégorie</label>
                <div class="category filter-item">
                    <SfMultiSelect TValue="string[]"
                                   TItem="FilterOption"
                                   DataSource="@_filterCategoryList"
                                   Mode="VisualMode.Box"
                                   Placeholder="Sélectionnez les catégories"
                                   HideSelectedItem="true"
                                   ClosePopupOnSelect="false">
                        <MultiSelectEvents TValue="string[]"
                                           TItem="FilterOption"
                                           OnValueSelect="CategorySelect"
                                           OnValueRemove="CategoryRemove"
                                           Cleared="ClearHandler">
                        </MultiSelectEvents>
                        <MultiSelectFieldSettings Text="Text" Value="Value"></MultiSelectFieldSettings>
                    </SfMultiSelect>
                </div>
                <label class="label-font">Comptes</label>
                <div class="category filter-item">
                    <SfMultiSelect TValue="string[]"
                                   TItem="FilterOption"
                                   DataSource="@_filterAccountList"
                                   Mode="VisualMode.Box"
                                   Placeholder="Sélectionnez les comptes"
                                   HideSelectedItem="true"
                                   ClosePopupOnSelect="false">
                        <MultiSelectEvents TValue="string[]"
                                           TItem="FilterOption"
                                           OnValueSelect="AccountSelect"
                                           OnValueRemove="AccountRemove"
                                           Cleared="AccountClearHandler">
                        </MultiSelectEvents>
                        <MultiSelectFieldSettings Text="Text" Value="Value"></MultiSelectFieldSettings>
                    </SfMultiSelect>
                </div>
                <label class="label-font bottom-align">Cashflow</label>
                <div class="cashflow filter-item">
                    <SfCheckBox TChecked="bool" Label="Entrée" @bind-Checked="_incomeChecked" CssClass="TransactionType" ValueChange="OnFilterControlChanged"></SfCheckBox>
                    <SfCheckBox TChecked="bool" Label="Sortie" @bind-Checked="_expenseChecked" CssClass="TransactionType" ValueChange="OnFilterControlChanged"></SfCheckBox>
                </div>
                <div>
                    <label class="label-font">Montant</label>
                    <div class="amount-filter">
                        <div class="min-numeric amt-filter">
                            <label class="inlineAlign minLabel">Min :</label>
                            <SfNumericTextBox TValue="double?" CssClass="inlineAlign" Width="55px" Format="n0" ShowSpinButton="false" @bind-Value="_minAmount" Min="0">
                                <NumericTextBoxEvents TValue="double?" ValueChange="OnFilterControlChanged"></NumericTextBoxEvents>
                            </SfNumericTextBox>
                        </div>
                        <span class="amt-filter separateLine"></span>
                        <div class="max-numeric amt-filter">
                            <label class="inlineAlign maxLabel">Max :</label>
                            <SfNumericTextBox TValue="double?" CssClass="inlineAlign" Width="55px" Format="n0" ShowSpinButton="false" @bind-Value="_maxAmount" Min="0">
                                <NumericTextBoxEvents TValue="double?" ValueChange="OnFilterControlChanged"></NumericTextBoxEvents>
                            </SfNumericTextBox>
                        </div>
                    </div>
                </div>
                <label class="label-font bottom-align">Gérer les comptes, devises et types</label>
                <div class="transaction-manage-actions">
                    <div><SfButton Content="Comptes" OnClick="OpenAccountsPanelAsync" /></div>
                    <div><SfButton Content="Devises" OnClick="OpenCurrenciesPanelAsync" /></div>
                    <div><SfButton Content="Types" OnClick="OpenTransactionTypesPanelAsync" /></div>
                    <div><SfButton Content="Catégories" OnClick="OpenCategoriesPanelAsync" /></div>
                </div>
            </div>
        </div>
    </aside>
</div>

<AccountGridPanel @ref="_accountPanel" Changed="OnLookupsChangedAsync" />
<CurrencyGridPanel @ref="_currencyPanel" Changed="OnCurrenciesChangedAsync" />
<TransactionTypeGridPanel @ref="_transactionTypePanel" Changed="OnLookupsChangedAsync" />
<TransactionCategoryGridPanel @ref="_categoryPanel" Changed="OnLookupsChangedAsync" />

@code {
    public TransactionGridPanel? ContentRef { get; set; }

    AccountGridPanel? _accountPanel;
    CurrencyGridPanel? _currencyPanel;
    TransactionTypeGridPanel? _transactionTypePanel;
    TransactionCategoryGridPanel? _categoryPanel;

    readonly List<Presets> _transactionDateRangePresets = DashboardDateRangePresets.StandardThreePresets();

    public DateTime StartDate { get; private set; }
    public DateTime EndDate { get; private set; }
    public Guid? CurrencyId { get; private set; }

    bool _mobileDrawerOpen;
    bool _incomeChecked = true;
    bool _expenseChecked = true;
    double? _minAmount;
    double? _maxAmount;
    readonly List<string> _categoryValues = new();
    readonly List<string> _accountValues = new();
    List<FilterOption> _filterCategoryList = new();
    List<FilterOption> _filterAccountList = new();
    List<CurrencyDto> _currencies = new();
    DateTime _pickerMinDate => new(2015, 1, 1, 0, 0, 0);
    DateTime _pickerMaxDate => new(DateTime.Today.Year + 5, 12, 31, 23, 59, 59);

    protected override async Task OnInitializedAsync()
    {
        (StartDate, EndDate) = TransactionGridPanel.GetCalendarMonthBounds(DateTime.Today);
        _minAmount = 0;
        _maxAmount = null;
        await LoadCurrenciesAsync();
    }

    public void SetDateRange(DateTime start, DateTime end)
    {
        StartDate = start;
        EndDate = end;
    }

    internal void ShowFilterMenu()
    {
        _mobileDrawerOpen = true;
        StateHasChanged();
    }

    void HideFilterMenu()
    {
        _mobileDrawerOpen = false;
        StateHasChanged();
    }

    Task OpenAccountsPanelAsync() => _accountPanel?.ShowAsync() ?? Task.CompletedTask;

    Task OpenCurrenciesPanelAsync() => _currencyPanel?.ShowAsync() ?? Task.CompletedTask;

    Task OpenTransactionTypesPanelAsync() => _transactionTypePanel?.ShowAsync() ?? Task.CompletedTask;

    Task OpenCategoriesPanelAsync() => _categoryPanel?.ShowAsync() ?? Task.CompletedTask;

    async Task LoadCurrenciesAsync()
    {
        try
        {
            var response = await CurrencyService.GetAllAsync();
            _currencies = response?.Data?.ToList() ?? [];
        }
        catch
        {
            _currencies = [];
        }

        if (CurrencyId is { } id && _currencies.All(c => c.Id != id))
            CurrencyId = null;
    }

    async Task OnCurrenciesChangedAsync()
    {
        await LoadCurrenciesAsync();
        if (ContentRef is not null)
            await ContentRef.RefreshCurrenciesAsync();
        await OnLookupsChangedAsync();
        StateHasChanged();
    }

    async Task OnLookupsChangedAsync()
    {
        if (ContentRef?.DialogRef is not null)
            await ContentRef.DialogRef.RefreshLookupsAsync();
    }

    void OnFilterToggleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            ShowFilterMenu();
    }

    public void CategorySelect(SelectEventArgs<FilterOption> args)
    {
        if (args.ItemData?.Value is { } v)
            _categoryValues.Add(v);
        UpdateGrid();
    }

    public void CategoryRemove(RemoveEventArgs<FilterOption> args)
    {
        if (args.ItemData?.Value is { } v)
            _categoryValues.Remove(v);
        UpdateGrid();
    }

    void ClearHandler()
    {
        _categoryValues.Clear();
        UpdateGrid();
    }

    public void AccountSelect(SelectEventArgs<FilterOption> args)
    {
        if (args.ItemData?.Value is { } v)
            _accountValues.Add(v);
        UpdateGrid();
    }

    public void AccountRemove(RemoveEventArgs<FilterOption> args)
    {
        if (args.ItemData?.Value is { } v)
            _accountValues.Remove(v);
        UpdateGrid();
    }

    void AccountClearHandler()
    {
        _accountValues.Clear();
        UpdateGrid();
    }

    async Task DateRangeChanged(RangePickerEventArgs<DateTime> args)
    {
        StartDate = args.StartDate;
        EndDate = args.EndDate;
        await ReloadTransactionsAsync();
    }

    async Task OnCurrencyChanged(ChangeEventArgs<Guid?, CurrencyDto> args)
    {
        CurrencyId = args.Value;
        await ReloadTransactionsAsync();
    }

    async Task ReloadTransactionsAsync()
    {
        if (ContentRef is null)
            return;

        await ContentRef.LoadTransactionsAsync(StartDate, EndDate, CurrencyId);
        RebuildCategoryList();
        UpdateGrid();
        ContentRef.UpdateTotalBalance();
    }

    void OnFilterControlChanged() => UpdateGrid();

    public void RebuildCategoryList()
    {
        if (ContentRef is null)
            return;

        var rows = ContentRef.AllTransactions;
        _filterCategoryList = rows
            .Select(r => r.TransactionCategory)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c)
            .Select(c => new FilterOption { Text = c, Value = c })
            .ToList();

        _filterAccountList = rows
            .Select(r => r.Account)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a)
            .Select(a => new FilterOption { Text = a, Value = a })
            .ToList();

        MinMaxAmount(rows);
    }

    void MinMaxAmount(IEnumerable<TransactionView> rows)
    {
        var slice = rows.ToList();
        if (slice.Count > 0)
        {
            _minAmount = (double)slice.Min(s => s.Amount);
            _maxAmount = (double)slice.Max(s => s.Amount);
        }
    }

    public IEnumerable<TransactionView> RefreshData()
    {
        if (ContentRef is null)
            return Array.Empty<TransactionView>();

        IEnumerable<TransactionView> rows = ContentRef.AllTransactions;

        var min = (decimal)(_minAmount ?? 0);
        var max = _maxAmount.HasValue ? (decimal)_maxAmount.Value : decimal.MaxValue;
        rows = rows.Where(s => s.Amount >= min && s.Amount <= max);

        if (_incomeChecked || _expenseChecked)
        {
            if (_incomeChecked && !_expenseChecked)
                rows = rows.Where(s => FinanceDisplaySupport.IsIncome(s.TransactionType));
            else if (_expenseChecked && !_incomeChecked)
                rows = rows.Where(s => FinanceDisplaySupport.IsExpense(s.TransactionType));
        }

        if (_accountValues.Count > 0)
            rows = rows.Where(s => _accountValues.Contains(s.Account));

        if (_categoryValues.Count > 0)
            rows = rows.Where(s => _categoryValues.Contains(s.TransactionCategory));

        return rows.OrderByDescending(e => e.TransactionDate).ToList();
    }

    public void UpdateGrid()
    {
        if (ContentRef is null)
            return;
        ContentRef.GridRefresh(RefreshData());
    }

    public void ApplyToolbarTypeFilter(string type)
    {
        switch (type)
        {
            case "Income":
                _incomeChecked = true;
                _expenseChecked = false;
                break;
            case "Expense":
                _incomeChecked = false;
                _expenseChecked = true;
                break;
            default:
                _incomeChecked = true;
                _expenseChecked = true;
                break;
        }

        UpdateGrid();
        StateHasChanged();
    }

    public sealed class FilterOption
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
