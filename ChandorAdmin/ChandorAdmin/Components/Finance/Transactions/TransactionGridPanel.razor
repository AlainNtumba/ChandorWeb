@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Navigations
@using ChandorProject.Shared.DTOs.Transaction
@implements IDisposable

<div id="expense-grid-wrapper">
    @if (_renderGrid)
    {
        <SfGrid @ref="TransactGridRef"
                TValue="TransactionView"
                Width="100%"
                Height="100%"
                AllowSelection="true"
                AllowPaging="true"
                AllowTextWrap="false"
                AllowExcelExport="true"
                Toolbar="@Toolbaritems"
                DataSource="@GridData">
            <GridEvents TValue="TransactionView"
                        RowSelected="OnRowSelectChanged"
                        RowDeselected="OnRowDeselectChanged"
                        OnToolbarClick="ToolbarClickHandler">
            </GridEvents>
            <GridEditSettings AllowEditing="true" AllowEditOnDblClick="false"></GridEditSettings>
            <GridPageSettings PageSize="11"></GridPageSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="40"></GridColumn>
                <GridColumn Field="@nameof(TransactionView.TransactionCategory)" HeaderText="Catégorie" Width="178" ClipMode="ClipMode.EllipsisWithTooltip" ValidationRules="@_rules">
                    <Template>
                        @{
                            var row = (TransactionView)context;
                            <div class="normalRes">
                                <div class="category-text">@row.TransactionCategory</div>
                            </div>
                            <div class="mediumRes">
                                <div>
                                    <div>@row.TransactionCategory</div>
                                    <div class="description-section">@row.TransactionNote</div>
                                </div>
                            </div>
                            <div class="smallRes">
                                <div class="sm-category category-content">
                                    <div>@row.TransactionCategory</div>
                                    <div class="description-section">@row.TransactionNote</div>
                                    <div>@row.Account</div>
                                </div>
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(TransactionView.TransactionDate)" HeaderText="Date" Format="d" Width="112" ValidationRules="@_rules"></GridColumn>
                <GridColumn Field="@nameof(TransactionView.Account)" HeaderText="Compte" Width="170" ValidationRules="@_rules"></GridColumn>
                <GridColumn Field="@nameof(TransactionView.Currency)" HeaderText="Devise" Width="140"></GridColumn>
                <GridColumn Field="@nameof(TransactionView.TransactionNote)" HeaderText="Note" ClipMode="ClipMode.Ellipsis"></GridColumn>
                <GridColumn Field="@nameof(TransactionView.Id)" HeaderText="Id" IsPrimaryKey="true" Visible="false"></GridColumn>
                <GridColumn Field="@nameof(TransactionView.Amount)" HeaderText="Montant" Width="120" TextAlign="TextAlign.Right" ValidationRules="@_rules">
                    <Template>
                        @{
                            var row = (TransactionView)context;
                            <div class="normalRes">
                                <div class="amt-payment @CashflowCss(row)">
                                    <span>@FormatRowAmount(row)</span>
                                </div>
                            </div>
                            <div class="mediumRes">
                                <div class="amt-payment @CashflowCss(row)">
                                    <span>@FormatRowAmount(row)</span>
                                </div>
                                <div>@row.TransactionDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="smallRes">
                                <div class="amt-payment @CashflowCss(row)">
                                    <span>@FormatRowAmount(row)</span>
                                </div>
                                <div>@row.TransactionDate.ToString("dd/MM/yyyy")</div>
                            </div>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
</div>
