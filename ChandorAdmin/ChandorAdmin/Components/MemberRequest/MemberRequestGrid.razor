@using ChandorProject.Shared.DTOs.MemberRequest

<SfGrid TValue="MemberRequestDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="request-empty">Aucune demande.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn HeaderText="Date" Width="160">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @(item?.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Type" Width="160">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @if (item is not null)
                {
                    <span class="request-type-code">@item.RequestTypeCode</span>
                    <div>@item.RequestTypeOptionsName</div>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Nom complet">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @if (item is not null)
                {
                    <span class="request-strong">@FullName(item)</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Téléphone" Width="140">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @if (item is not null)
                {
                    <a href="tel:@item.Phone">@item.Phone</a>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Sujet">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @if (item is not null)
                {
                    <strong>@item.Subject</strong>
                    <div class="request-message-preview">@Preview(item.Message)</div>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Profil" Width="110">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @(item is null ? null : item.MemberId.HasValue ? "Membre" : "Visiteur")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Statut" Width="140">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @if (item is not null)
                {
                    <span class="request-status @StatusClass(item.Status)">@StatusLabel(item.Status)</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Modification" Width="160">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @(item is null ? null : item.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="340">
            <Template>
                @{ var item = context as MemberRequestDto; }
                @if (item is not null)
                {
                    <div class="request-actions">
                        <SfButton OnClick="@(() => View.InvokeAsync(item))">Voir</SfButton>
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton OnClick="@(() => ChangeStatus.InvokeAsync(item))">Statut</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<MemberRequestDto> Items { get; set; } = [];
    [Parameter] public EventCallback<MemberRequestDto> View { get; set; }
    [Parameter] public EventCallback<MemberRequestDto> Edit { get; set; }
    [Parameter] public EventCallback<MemberRequestDto> ChangeStatus { get; set; }
    [Parameter] public EventCallback<MemberRequestDto> Delete { get; set; }
    private static string FullName(MemberRequestDto item) => string.Join(" ", new[] { item.LastName, item.MiddleName, item.FirstName }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string Preview(string text) => text.Length > 70 ? $"{text[..67]}…" : text;
    private static string StatusClass(string value) => $"status-{NormalizeStatus(value).ToLowerInvariant().Replace('_', '-')}";
    private static string StatusLabel(string value) => NormalizeStatus(value) switch { "PENDING" => "En attente", "IN_PROGRESS" => "En traitement", "PROCESSED" => "Traitée", "REJECTED" => "Rejetée", "CANCELLED" => "Annulée", _ => value };
    private static string NormalizeStatus(string value) => value.Trim().Replace("-", "_").Replace(" ", "_").ToUpperInvariant();
}
