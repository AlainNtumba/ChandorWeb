@using ChandorProject.Shared.DTOs.RequestType

<SfGrid TValue="RequestTypeDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="request-empty">Aucun type de demande.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(RequestTypeDto.Code)" HeaderText="Code" Width="140" />
        <GridColumn Field="@nameof(RequestTypeDto.OptionsName)" HeaderText="Libellé" />
        <GridColumn HeaderText="Description">
            <Template>
                @{ var item = context as RequestTypeDto; }
                @(item is null ? null : item.Description ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actif" Width="120">
            <Template>
                @{ var item = context as RequestTypeDto; }
                @if (item is not null)
                {
                    <span class="request-status @(item.IsActive ? "status-processed" : "status-cancelled")">@(item.IsActive ? "Actif" : "Inactif")</span>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(RequestTypeDto.RequestCount)" HeaderText="Demandes" Width="120" />
        <GridColumn HeaderText="Actions" Width="220">
            <Template>
                @{ var item = context as RequestTypeDto; }
                @if (item is not null)
                {
                    <div class="request-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<RequestTypeDto> Items { get; set; } = [];
    [Parameter] public EventCallback<RequestTypeDto> Edit { get; set; }
    [Parameter] public EventCallback<RequestTypeDto> Delete { get; set; }
}
