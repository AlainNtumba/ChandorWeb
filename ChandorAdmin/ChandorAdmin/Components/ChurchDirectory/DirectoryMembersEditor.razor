@using ChandorProject.Shared.DTOs.ChurchDirectory
@using ChandorProject.Shared.DTOs.Member

<div class="directory-editor-list">
    <div class="directory-editor-list__header"><div><span class="directory-editor-list__icon e-icons e-people" aria-hidden="true"></span><span><strong>Responsables</strong><small>Sélectionnez les membres responsables de cet élément.</small></span></div></div>
    <div class="directory-member-toolbar">
        <label class="directory-member-search"><span class="e-icons e-search" aria-hidden="true"></span><input type="search" @bind="_search" @bind:event="oninput" placeholder="Rechercher un membre…" /></label>
        <div class="directory-member-add"><select @bind="_selectedMemberId"><option value="@Guid.Empty">Sélectionnez un membre</option>@foreach (var member in AvailableMembers) { <option value="@member.Id">@MemberName(member)</option> }</select><button type="button" disabled="@(_selectedMemberId == Guid.Empty)" @onclick="Add"><span class="e-icons e-plus" aria-hidden="true"></span>Ajouter</button></div>
    </div>
    @if (Members.Count == 0) { <div class="directory-empty-small"><span class="e-icons e-people" aria-hidden="true"></span><strong>Aucun responsable</strong><small>Recherchez puis sélectionnez un membre pour l’ajouter.</small></div> }
    @foreach (var row in Members.ToList())
    {
        var member = AllMembers.FirstOrDefault(x => x.Id == row.MemberId);
        <div class="directory-member-row">
            @if (!string.IsNullOrWhiteSpace(member?.ProfileImageUrl)) { <img src="@member.ProfileImageUrl" alt="" /> } else { <span class="directory-member-avatar">@Initials(member, row)</span> }
            <div class="directory-member-identity"><strong>@(row.MemberName ?? MemberName(member))</strong><small>Membre de l’église</small></div>
            <label class="directory-member-role"><span>Rôle</span><input placeholder="Ex. Responsable" @bind="row.Role" /></label>
            <label class="directory-primary-check"><input type="checkbox" checked="@row.IsPrimary" @onchange="args => SetPrimary(row, (bool)args.Value!)" /><span>Principal</span></label>
            <button type="button" class="directory-remove-button" title="Retirer ce responsable" aria-label="Retirer ce responsable" @onclick="() => Members.Remove(row)"><span class="e-icons e-trash" aria-hidden="true"></span><span>Supprimer</span></button>
        </div>
    }
</div>

@code {
    private Guid _selectedMemberId;
    private string _search = string.Empty;
    [Parameter, EditorRequired] public List<ChurchDirectoryMemberDto> Members { get; set; } = [];
    [Parameter] public IReadOnlyList<MemberDto> AllMembers { get; set; } = [];
    private IEnumerable<MemberDto> AvailableMembers => AllMembers
        .Where(x => Members.All(row => row.MemberId != x.Id))
        .Where(x => string.IsNullOrWhiteSpace(_search) || MemberName(x).Contains(_search, StringComparison.OrdinalIgnoreCase));
    private void Add()
    {
        if (_selectedMemberId == Guid.Empty || Members.Any(x => x.MemberId == _selectedMemberId)) return;
        var member = AllMembers.First(x => x.Id == _selectedMemberId);
        Members.Add(new ChurchDirectoryMemberDto { MemberId = member.Id, MemberName = MemberName(member), Role = "Responsable", IsPrimary = Members.Count == 0 });
        _selectedMemberId = Guid.Empty;
    }
    private void SetPrimary(ChurchDirectoryMemberDto item, bool value) { item.IsPrimary = value; if (value) foreach (var other in Members.Where(x => !ReferenceEquals(x, item))) other.IsPrimary = false; }
    private static string MemberName(MemberDto? member) => member is null ? "Membre inconnu" : string.Join(" ", new[] { member.Name, member.Postname, member.Surname }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string Initials(MemberDto? member, ChurchDirectoryMemberDto row) => member is null ? (row.MemberName?.FirstOrDefault().ToString() ?? "?") : $"{member.Name.FirstOrDefault()}{member.Surname.FirstOrDefault()}".ToUpperInvariant();
}
