@using ChandorProject.Shared.DTOs.ChurchDirectory

<SfGrid TValue="ChurchDirectoryTypeDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="directory-empty">Aucun type.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn HeaderText="Hero" Width="90">
            <Template>
                @{ var item = context as ChurchDirectoryTypeDto; }
                @if (item is not null)
                {
                    @if (!string.IsNullOrWhiteSpace(item.HeroImageUrl))
                    {
                        <img class="directory-thumb" src="@item.HeroImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="directory-thumb-empty">—</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(ChurchDirectoryTypeDto.Name)" HeaderText="Nom" />
        <GridColumn Field="@nameof(ChurchDirectoryTypeDto.DisplayKind)" HeaderText="Affichage" Width="140" />
        <GridColumn Field="@nameof(ChurchDirectoryTypeDto.ItemCount)" HeaderText="Éléments" Width="110" />
        <GridColumn Field="@nameof(ChurchDirectoryTypeDto.ActiveItemCount)" HeaderText="Actifs" Width="100" />
        <GridColumn Field="@nameof(ChurchDirectoryTypeDto.SortOrder)" HeaderText="Ordre" Width="90" />
        <GridColumn HeaderText="Statut" Width="120">
            <Template>
                @{ var item = context as ChurchDirectoryTypeDto; }
                @if (item is not null)
                {
                    <span class="directory-status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Actif" : "Inactif")</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="220">
            <Template>
                @{ var item = context as ChurchDirectoryTypeDto; }
                @if (item is not null)
                {
                    <div class="directory-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<ChurchDirectoryTypeDto> Items { get; set; } = [];
    [Parameter] public EventCallback<ChurchDirectoryTypeDto> Edit { get; set; }
    [Parameter] public EventCallback<ChurchDirectoryTypeDto> Delete { get; set; }
}
