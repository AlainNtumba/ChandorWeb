@using ChandorAdmin.Configuration
@using ChandorAdmin.Models.ChurchDirectory
@using Microsoft.Extensions.Options
@inject IOptions<ChandorApiOptions> ApiOptions

<div class="directory-image-picker">
    <div class="directory-image-picker__preview">
        @if (!string.IsNullOrWhiteSpace(ResolvedPreviewUrl))
        {
            <img src="@ResolvedPreviewUrl" alt="Aperçu de l’image Hero" />
            <span class="directory-image-picker__state">@(SelectedImage is null ? "Image actuelle" : "Nouvelle image")</span>
        }
        else
        {
            <div class="directory-image-picker__empty"><span class="e-icons e-image" aria-hidden="true"></span><strong>Aucune image</strong><small>L’aperçu apparaîtra ici</small></div>
        }
    </div>
    <div class="directory-image-picker__controls">
        <div class="directory-image-picker__copy"><strong>Image de couverture</strong><p>Choisissez une image horizontale nette pour présenter ce type dans l’annuaire.</p></div>
        <div class="directory-image-picker__actions">
            <label class="directory-file-button"><span class="e-icons e-image" aria-hidden="true"></span>@(HasVisibleImage ? "Remplacer" : "Choisir une image")<InputFile @key="_inputKey" OnChange="OnFileSelectedAsync" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" /></label>
            @if (SelectedImage is not null) { <button type="button" class="secondary" @onclick="ClearSelectedAsync"><span class="e-icons e-close" aria-hidden="true"></span>Retirer</button> }
            else if (!string.IsNullOrWhiteSpace(ExistingImageUrl) && !DeleteRequested) { <button type="button" class="danger" @onclick="RequestDeleteAsync"><span class="e-icons e-trash" aria-hidden="true"></span>Supprimer</button> }
            else if (DeleteRequested) { <button type="button" class="secondary" @onclick="CancelDeleteAsync">Annuler la suppression</button> }
        </div>
        <div class="directory-image-picker__hint"><span>JPEG, PNG ou WebP</span><span>5 Mo maximum</span></div>
        @if (SelectedImage is not null) { <div class="directory-image-picker__file"><span class="e-icons e-circle-check" aria-hidden="true"></span><span><strong>@SelectedImage.FileName</strong><small>@FormatSize(SelectedImage.Content.LongLength)</small></span></div> }
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="directory-inline-error">@_error</div> }
    </div>
</div>

@code {
    private const long MaximumSize = 5 * 1024 * 1024;
    private string? _error;
    private int _inputKey;

    [Parameter] public string? ExistingImageUrl { get; set; }
    [Parameter] public DirectoryImageUpload? SelectedImage { get; set; }
    [Parameter] public EventCallback<DirectoryImageUpload?> SelectedImageChanged { get; set; }
    [Parameter] public bool DeleteRequested { get; set; }
    [Parameter] public EventCallback<bool> DeleteRequestedChanged { get; set; }

    private bool HasVisibleImage => SelectedImage is not null || (!DeleteRequested && !string.IsNullOrWhiteSpace(ExistingImageUrl));
    private string? PreviewUrl => SelectedImage is not null ? $"data:{SelectedImage.ContentType};base64,{Convert.ToBase64String(SelectedImage.Content)}" : DeleteRequested ? null : ExistingImageUrl;
    private string? ResolvedPreviewUrl => ResolveImageUrl(PreviewUrl);

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        var file = args.File;
        if (file.Size <= 0 || file.Size > MaximumSize) { _error = "L’image doit avoir une taille comprise entre 1 octet et 5 Mo."; return; }
        try
        {
            await using var source = file.OpenReadStream(MaximumSize);
            using var buffer = new MemoryStream((int)file.Size);
            await source.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            var contentType = DetectType(bytes);
            if (contentType is null) { _error = "Sélectionnez une véritable image JPEG, PNG ou WebP."; return; }
            await SelectedImageChanged.InvokeAsync(new DirectoryImageUpload(file.Name, contentType, bytes));
            await DeleteRequestedChanged.InvokeAsync(false);
        }
        catch (IOException) { _error = "Impossible de lire cette image."; }
    }

    private async Task ClearSelectedAsync() { _inputKey++; await SelectedImageChanged.InvokeAsync(null); }
    private async Task RequestDeleteAsync() { await SelectedImageChanged.InvokeAsync(null); await DeleteRequestedChanged.InvokeAsync(true); }
    private Task CancelDeleteAsync() => DeleteRequestedChanged.InvokeAsync(false);

    private string? ResolveImageUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (value.StartsWith("data:", StringComparison.OrdinalIgnoreCase)) return value;
        var configuredBase = new Uri(ApiOptions.Value.BaseUrl.TrimEnd('/') + "/");
        var origin = new Uri(configuredBase.GetLeftPart(UriPartial.Authority) + "/");
        if (Uri.TryCreate(value, UriKind.Absolute, out var absolute))
        {
            if (absolute.AbsolutePath.StartsWith("/media/", StringComparison.OrdinalIgnoreCase))
                return new Uri(origin, absolute.PathAndQuery.TrimStart('/')).ToString();
            return absolute.ToString();
        }
        return new Uri(origin, value.TrimStart('/')).ToString();
    }

    private static string FormatSize(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / 1024d / 1024d:0.##} Mo"
        : $"{bytes / 1024d:0.#} Ko";

    private static string? DetectType(ReadOnlySpan<byte> bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xff && bytes[1] == 0xd8 && bytes[2] == 0xff) return "image/jpeg";
        ReadOnlySpan<byte> png = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
        if (bytes.Length >= png.Length && bytes[..png.Length].SequenceEqual(png)) return "image/png";
        if (bytes.Length >= 12 && bytes[..4].SequenceEqual("RIFF"u8) && bytes.Slice(8, 4).SequenceEqual("WEBP"u8)) return "image/webp";
        return null;
    }
}
