@using ChandorProject.Shared.DTOs.ChurchDirectory

<SfGrid TValue="ChurchDirectoryItemDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="directory-empty">Aucun élément.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn HeaderText="Image" Width="90">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @if (item is not null)
                {
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img class="directory-thumb" src="@item.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="directory-thumb-empty">—</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(ChurchDirectoryItemDto.Name)" HeaderText="Nom" />
        <GridColumn Field="@nameof(ChurchDirectoryItemDto.TypeCode)" HeaderText="Type" Width="120" />
        <GridColumn HeaderText="Parent" Width="140">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @(item is null ? null : item.ParentName ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Département" Width="150">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @(item is null ? null : item.DepartmentName ?? "—")
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(ChurchDirectoryItemDto.ChildCount)" HeaderText="Enfants" Width="100" />
        <GridColumn HeaderText="Responsable" Width="160">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @(item is null ? null : item.Members.FirstOrDefault(x => x.IsPrimary)?.MemberName ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Contact" Width="160">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @(item is null ? null : Contact(item))
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(ChurchDirectoryItemDto.SortOrder)" HeaderText="Ordre" Width="90" />
        <GridColumn HeaderText="Statut" Width="120">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @if (item is not null)
                {
                    <span class="directory-status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Actif" : "Inactif")</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="220">
            <Template>
                @{ var item = context as ChurchDirectoryItemDto; }
                @if (item is not null)
                {
                    <div class="directory-actions">
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<ChurchDirectoryItemDto> Items { get; set; } = [];
    [Parameter] public EventCallback<ChurchDirectoryItemDto> Edit { get; set; }
    [Parameter] public EventCallback<ChurchDirectoryItemDto> Delete { get; set; }
    private static string Contact(ChurchDirectoryItemDto item)
    {
        var value = item.Contacts.FirstOrDefault(x => x.IsPrimary)?.Value ?? item.Contacts.FirstOrDefault()?.Value;
        return value ?? "—";
    }
}
