@using ChandorAdmin.Interfaces.Api
@using ChandorProject.Shared.DTOs.Member
@using Syncfusion.Blazor.Buttons
@inject IAgeGroupService AgeGroupService

<div class="transactions-filter-root">
    <span id="filter-toggle"
          class="navbar-toggle e-icons e-filter"
          role="button"
          tabindex="0"
          aria-label="Open filters"
          @onclick="ShowFilterMenu"
          @onkeydown="OnFilterToggleKey"></span>

    @if (_mobileDrawerOpen)
    {
        <div class="overlay" @onclick="HideFilterMenu"></div>
    }

    <aside class="transactions-filter-dock @(_mobileDrawerOpen ? "transactions-filter-dock--open" : null)" aria-label="Department member filters">
        <div class="sidebar-wrapper-filter">
            <div class="filter-head">
                <span class="e-icon filter-icon filter-head-item"></span>
                <span class="filter-txt filter-head-item">@FilterHeaderText</span>
            </div>
            <div class="expense-filter-container">
                <label class="label-font">Genre</label>
                <div class="cashflow filter-item">
                    <SfCheckBox TChecked="bool" Label="Femme" @bind-Checked="_femaleChecked" CssClass="TransactionType" ValueChange="OnGenderFilterControlChanged"></SfCheckBox>
                    <SfCheckBox TChecked="bool" Label="Homme" @bind-Checked="_maleChecked" CssClass="TransactionType" ValueChange="OnGenderFilterControlChanged"></SfCheckBox>
                </div>
                @if (_ageGroupFilterOptions.Count > 0)
                {
                    <label class="label-font bottom-align">Tranches d'âge</label>
                    <div class="paymentModes filter-item">
                        @foreach (var ageGroup in _ageGroupFilterOptions)
                        {
                            <SfCheckBox TChecked="bool"
                                        Label="@ageGroup.Text"
                                        Checked="@IsAgeGroupChecked(ageGroup.Value)"
                                        CssClass="PaymentMode"
                                        ValueChange="@(args => OnAgeGroupFilterChanged(ageGroup.Value, args))">
                            </SfCheckBox>
                            <br />
                        }
                    </div>
                }
                <label class="label-font bottom-align">Gestion d'information</label>
                <div class="transaction-manage-actions">
                    <div><SfButton Content="Programme" OnClick="OnProgrammeClick" /></div>
                    <div><SfButton Content="Finance" OnClick="OnFinanceClick" /></div>
                </div>
            </div>
        </div>
    </aside>
</div>

<DepartmentCalendar @ref="_calendarRef" DepartmentId="DepartmentId" />

@code {
    [Parameter] public Guid DepartmentId { get; set; }
    [Parameter] public string? DepartmentName { get; set; }

    public DepartmentMemberGridPanel? ContentRef { get; set; }

    DepartmentCalendar? _calendarRef;

    bool _mobileDrawerOpen;
    bool _femaleChecked = true;
    bool _maleChecked = true;
    readonly HashSet<Guid> _selectedAgeGroupIds = [];
    List<FilterAgeGroupOption> _ageGroupFilterOptions = [];

    public System.Action? ToolbarSyncRequested { get; set; }

    string FilterHeaderText =>
        string.IsNullOrWhiteSpace(DepartmentName) ? "Filtres" : DepartmentName.Trim();

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterDataSourcesAsync();
    }

    async Task LoadFilterDataSourcesAsync()
    {
        try
        {
            var ageGroupsResponse = await AgeGroupService.GetAllAgeGroupsAsync();
            if (ageGroupsResponse is { Success: true, Data: not null })
            {
                _ageGroupFilterOptions = ageGroupsResponse.Data
                    .Where(a => !string.IsNullOrWhiteSpace(a.GroupName))
                    .OrderBy(a => a.FromAge)
                    .Select(a => new FilterAgeGroupOption { Text = a.GroupName, Value = a.Id })
                    .ToList();
            }
        }
        catch
        {
            _ageGroupFilterOptions = [];
        }

        _selectedAgeGroupIds.Clear();
    }

    internal void ShowFilterMenu()
    {
        _mobileDrawerOpen = true;
        StateHasChanged();
    }

    void HideFilterMenu()
    {
        _mobileDrawerOpen = false;
        StateHasChanged();
    }

    Task OnProgrammeClick() =>
        _calendarRef?.ShowAsync(DepartmentId, DepartmentName) ?? Task.CompletedTask;

    void OnFinanceClick()
    {
        // Wired to Finance component later.
    }

    void OnFilterToggleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            ShowFilterMenu();
    }

    void OnGenderFilterControlChanged()
    {
        UpdateGrid();
        ToolbarSyncRequested?.Invoke();
    }

    public string GetSelectedGenderFilterValue()
    {
        if (_femaleChecked && !_maleChecked)
            return "false";
        if (!_femaleChecked && _maleChecked)
            return "true";
        return string.Empty;
    }

    public void SetGenderFilter(string? genderValue)
    {
        if (string.IsNullOrWhiteSpace(genderValue))
        {
            _femaleChecked = true;
            _maleChecked = true;
        }
        else if (string.Equals(genderValue, "true", StringComparison.OrdinalIgnoreCase))
        {
            _maleChecked = true;
            _femaleChecked = false;
        }
        else if (string.Equals(genderValue, "false", StringComparison.OrdinalIgnoreCase))
        {
            _maleChecked = false;
            _femaleChecked = true;
        }

        UpdateGrid();
        StateHasChanged();
    }

    public void ClearGenderFilter() => SetGenderFilter(null);

    bool IsAgeGroupChecked(Guid ageGroupId) =>
        _selectedAgeGroupIds.Count == 0 || _selectedAgeGroupIds.Contains(ageGroupId);

    void OnAgeGroupFilterChanged(Guid ageGroupId, Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        if (_ageGroupFilterOptions.Count == 0)
            return;

        if (_selectedAgeGroupIds.Count == 0)
            _selectedAgeGroupIds.UnionWith(_ageGroupFilterOptions.Select(a => a.Value));

        if (args.Checked)
            _selectedAgeGroupIds.Add(ageGroupId);
        else
            _selectedAgeGroupIds.Remove(ageGroupId);

        if (_selectedAgeGroupIds.Count == _ageGroupFilterOptions.Count)
            _selectedAgeGroupIds.Clear();

        UpdateGrid();
    }

    public async Task RebuildFilterListsAsync()
    {
        await LoadFilterDataSourcesAsync();
        _selectedAgeGroupIds.Clear();
        StateHasChanged();
    }

    public IEnumerable<MemberDto> RefreshData()
    {
        if (ContentRef is null)
            return Array.Empty<MemberDto>();

        IEnumerable<MemberDto> rows = ContentRef.AllMembers;

        if (_femaleChecked && !_maleChecked)
            rows = rows.Where(m => !m.Gender);
        else if (!_femaleChecked && _maleChecked)
            rows = rows.Where(m => m.Gender);

        if (_selectedAgeGroupIds.Count > 0)
            rows = rows.Where(m => _selectedAgeGroupIds.Contains(m.AgeGroupId));

        return rows.ToList();
    }

    public void UpdateGrid()
    {
        if (ContentRef is null)
            return;
        ContentRef.GridRefresh(RefreshData());
    }

    public sealed class FilterAgeGroupOption
    {
        public string Text { get; set; } = "";
        public Guid Value { get; set; }
    }
}
