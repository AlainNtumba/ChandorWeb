@using ChandorAdmin.Interfaces.Api
@using ChandorProject.Shared.DTOs.Member
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Navigations
@inject IDepartmentService srv

<div id="expense-grid-wrapper">
    @if (_renderGrid)
    {
        <SfGrid @ref="MemberGridRef"
                TValue="MemberDto"
                Width="100%"
                Height="100%"
                AllowSelection="true"
                AllowPaging="true"
                AllowSorting="true"
                AllowTextWrap="false"
                AllowExcelExport="true"
                Toolbar="@Toolbaritems"
                DataSource="@GridData">
            <GridEvents TValue="MemberDto"
                        RowSelected="OnRowSelectChanged"
                        RowDeselected="OnRowDeselectChanged"
                        OnToolbarClick="ToolbarClickHandler">
            </GridEvents>
            <GridEditSettings AllowEditing="false" AllowEditOnDblClick="false"></GridEditSettings>
            <GridPageSettings PageSize="11"></GridPageSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="40"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Name)" HeaderText="Nom" Width="120"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Surname)" HeaderText="Prénom" Width="120"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Postname)" HeaderText="Poste Nom" Width="120"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Gender)" HeaderText="Genre" ClipMode="ClipMode.Ellipsis">
                    <Template>
                        @{
                            var row = (MemberDto)context;
                            var gender = row.Gender ? "Homme" : "Femme";
                            <div>@gender</div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(MemberDto.Town)" HeaderText="Ville" ClipMode="ClipMode.Ellipsis"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Country)" HeaderText="Pays" ClipMode="ClipMode.Ellipsis"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Address)" HeaderText="Adresse" ClipMode="ClipMode.Ellipsis"></GridColumn>
                <GridColumn Field="@nameof(MemberDto.Id)" HeaderText="Unique Id" IsPrimaryKey="true" Visible="false"></GridColumn>
            </GridColumns>
        </SfGrid>
    }
</div>
