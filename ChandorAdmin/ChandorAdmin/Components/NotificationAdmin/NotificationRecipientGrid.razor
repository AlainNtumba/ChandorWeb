@using ChandorProject.Shared.DTOs.Notification

<SfGrid TValue="NotificationRecipientAdminDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="notification-empty">Aucun destinataire pour ces filtres.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(NotificationRecipientAdminDto.MemberName)" HeaderText="Membre" />
        <GridColumn Field="@nameof(NotificationRecipientAdminDto.Username)" HeaderText="Identifiant" Width="160" />
        <GridColumn HeaderText="Livraison" Width="160">
            <Template>
                @{ var item = context as NotificationRecipientAdminDto; }
                @(item is null ? null : Date(item.DeliveredAt))
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Lecture" Width="160">
            <Template>
                @{ var item = context as NotificationRecipientAdminDto; }
                @(item is null ? null : Date(item.ReadAt))
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Rejet" Width="160">
            <Template>
                @{ var item = context as NotificationRecipientAdminDto; }
                @(item is null ? null : Date(item.DismissedAt))
            </Template>
        </GridColumn>
        <GridColumn HeaderText="État" Width="130">
            <Template>
                @{ var item = context as NotificationRecipientAdminDto; }
                @if (item is not null)
                {
                    <span class="notification-status @StateCss(item)">@State(item)</span>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<NotificationRecipientAdminDto> Items { get; set; } = [];
    private static string Date(DateTime? value) => value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—";
    private static string State(NotificationRecipientAdminDto item) => item.DismissedAt.HasValue ? "Rejetée" : item.ReadAt.HasValue ? "Lue" : "Non lue";
    private static string StateCss(NotificationRecipientAdminDto item) => item.DismissedAt.HasValue ? "state-dismissed" : item.ReadAt.HasValue ? "state-read" : "state-unread";
}
