@using ChandorProject.Shared.DTOs.Notification

<SfGrid TValue="NotificationAdminDto" DataSource="@Items" AllowPaging="false" Width="100%">
    <GridTemplates>
        <EmptyRecordTemplate><div class="notification-empty">Aucune notification.</div></EmptyRecordTemplate>
    </GridTemplates>
    <GridColumns>
        <GridColumn HeaderText="Titre">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @if (item is not null)
                {
                    <strong>@item.Title</strong>
                    <div class="notification-message-preview">@Preview(item.Message)</div>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Audience" Width="160">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @if (item is not null)
                {
                    <span class="notification-audience">@AudienceLabel(item.AudienceType)</span>
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Statut" Width="150">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @if (item is not null)
                {
                    <span class="notification-status @StatusCss(item.Status)">@StatusLabel(item.Status)</span>
                    @if (!item.IsActive)
                    {
                        <small class="notification-inactive">Inactive</small>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Publication" Width="160">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @(item is null ? null : item.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Expiration" Width="160">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @(item is null ? null : item.ExpiresAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(NotificationAdminDto.RecipientCount)" HeaderText="Destinataires" Width="130" />
        <GridColumn HeaderText="Lectures" Width="110">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @if (item is not null)
                {
                    @($"{item.ReadCount} / {item.RecipientCount}")
                }
            </Template>
        </GridColumn>
        <GridColumn HeaderText="Actions" Width="460">
            <Template>
                @{ var item = context as NotificationAdminDto; }
                @if (item is not null)
                {
                    <div class="notification-actions">
                        <SfButton OnClick="@(() => View.InvokeAsync(item))">Voir</SfButton>
                        <SfButton OnClick="@(() => Edit.InvokeAsync(item))">Modifier</SfButton>
                        <SfButton OnClick="@(() => Recipients.InvokeAsync(item))">Destinataires</SfButton>
                        @if (Normalize(item.Status) != "PUBLISHED")
                        {
                            <SfButton OnClick="@(() => Publish.InvokeAsync(item))">Publier</SfButton>
                        }
                        @if (Normalize(item.Status) != "DRAFT")
                        {
                            <SfButton OnClick="@(() => Draft.InvokeAsync(item))">Brouillon</SfButton>
                        }
                        @if (Normalize(item.Status) != "ARCHIVED")
                        {
                            <SfButton OnClick="@(() => Archive.InvokeAsync(item))">Archiver</SfButton>
                        }
                        <SfButton CssClass="danger" OnClick="@(() => Delete.InvokeAsync(item))">Supprimer</SfButton>
                    </div>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    [Parameter] public IReadOnlyList<NotificationAdminDto> Items { get; set; } = [];
    [Parameter] public EventCallback<NotificationAdminDto> View { get; set; }
    [Parameter] public EventCallback<NotificationAdminDto> Edit { get; set; }
    [Parameter] public EventCallback<NotificationAdminDto> Recipients { get; set; }
    [Parameter] public EventCallback<NotificationAdminDto> Publish { get; set; }
    [Parameter] public EventCallback<NotificationAdminDto> Draft { get; set; }
    [Parameter] public EventCallback<NotificationAdminDto> Archive { get; set; }
    [Parameter] public EventCallback<NotificationAdminDto> Delete { get; set; }
    private static string Preview(string value) => value.Length > 80 ? $"{value[..77]}…" : value;
    private static string Normalize(string value) => value.Trim().Replace("-", "_").Replace(" ", "_").ToUpperInvariant();
    private static string StatusCss(string value) => $"status-{Normalize(value).ToLowerInvariant()}";
    private static string StatusLabel(string value) => Normalize(value) switch { "DRAFT" => "Brouillon", "PUBLISHED" => "Publiée", "ARCHIVED" => "Archivée", _ => value };
    private static string AudienceLabel(string value) => Normalize(value) switch { "GLOBAL" => "Tous les membres", "SPECIFIC" => "Membres précis", "MEMBER_TYPE" => "Types de membres", "AGE_GROUP" => "Tranches d’âge", "DEPARTMENT_TEAM" => "Équipes", _ => value };
}
