@using ChandorAdmin.Configuration
@using ChandorAdmin.Interfaces.Api
@using ChandorAdmin.Models.Member
@using ChandorProject.Shared.DTOs.AgeGroup
@using ChandorProject.Shared.DTOs.Member
@using ChandorProject.Shared.DTOs.MemberType
@inject IMemberTypeService _typeServ
@inject IAgeGroupService _ageServ
@inject SfDialogService DialogService

<div id="dlg-content">
    <SfDialogProvider />
    <div id="et-dialog-target">
        @if (_createNewDialog)
        {
            <SfDialog IsModal="true"
                      @ref="@_memberDialog"
                      Header="@_dialogHeader"
                      Width="min(100%, 520px)"
                      CloseOnEscape="false">
                <DialogTemplates>
                    <Content>
                        <div>
                            <EditForm Model="@_editModel" id="@_formId" OnValidSubmit="OnValidSubmitAsync">
                                <DataAnnotationsValidator />
                                <CustomFormValidator @ref="@_customFormValidator" />
                                <section class="member-photo-editor">
                                    <div class="member-photo-editor__preview">
                                        @if (!string.IsNullOrWhiteSpace(ProfilePreviewUrl))
                                        {
                                            <img src="@ProfilePreviewUrl" alt="Photo de profil de @_editModel.Name" />
                                        }
                                        else
                                        {
                                            <span>@MemberInitials</span>
                                        }
                                    </div>
                                    <div class="member-photo-editor__content">
                                        <div class="member-photo-editor__title">Photo de profil</div>
                                        <div class="member-photo-editor__hint">JPEG, PNG ou WebP — 5 Mo maximum.</div>
                                        <div class="member-photo-editor__actions">
                                            <label class="e-control e-btn e-primary member-photo-editor__upload">
                                                @(HasVisibleProfileImage ? "Remplacer" : "Ajouter une photo")
                                                <InputFile @key="_profileInputKey"
                                                           OnChange="OnProfileImageSelectedAsync"
                                                           accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
                                            </label>
                                            @if (_selectedProfileImage is not null)
                                            {
                                                <button type="button" class="e-control e-btn e-flat" @onclick="RemoveSelectedProfileImage">Retirer</button>
                                            }
                                            else if (HasExistingProfileImage && !_deleteProfileImage)
                                            {
                                                <button type="button" class="e-control e-btn e-danger e-flat" @onclick="MarkProfileImageForDeletion">Supprimer</button>
                                            }
                                            else if (_deleteProfileImage)
                                            {
                                                <button type="button" class="e-control e-btn e-flat" @onclick="CancelProfileImageDeletion">Annuler la suppression</button>
                                            }
                                        </div>
                                        @if (_deleteProfileImage)
                                        {
                                            <div class="member-photo-editor__pending">La photo sera supprimée lors de l’enregistrement.</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_profileError))
                                        {
                                            <div class="member-photo-editor__error" role="alert">@_profileError</div>
                                        }
                                    </div>
                                </section>
                                <table class="c-table">
                                    <tbody>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Username"
                                                               Placeholder="Nom d'utilisateur"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Username)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="c-table">
                                    <tbody>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div class="e-float-input e-control-wrapper">
                                                    <input type="email" class="e-control e-textbox" @bind="_email1" />
                                                    <span class="e-float-line"></span>
                                                    <label class="e-float-text e-label-top">Email principal</label>
                                                </div>
                                            </td>
                                            <td class="e-rowcell">
                                                <div class="e-float-input e-control-wrapper">
                                                    <input type="email" class="e-control e-textbox" @bind="_email2" />
                                                    <span class="e-float-line"></span>
                                                    <label class="e-float-text e-label-top">Email secondaire</label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div class="e-float-input e-control-wrapper">
                                                    <input type="tel" class="e-control e-textbox" @bind="_phone1" />
                                                    <span class="e-float-line"></span>
                                                    <label class="e-float-text e-label-top">Téléphone principal</label>
                                                </div>
                                            </td>
                                            <td class="e-rowcell">
                                                <div class="e-float-input e-control-wrapper">
                                                    <input type="tel" class="e-control e-textbox" @bind="_phone2" />
                                                    <span class="e-float-line"></span>
                                                    <label class="e-float-text e-label-top">Téléphone secondaire</label>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Name"
                                                               Placeholder="Nom"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Name)" /></span>
                                                </span>
                                            </td>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Postname"
                                                               Placeholder="Poste nom"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Postname)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Surname"
                                                               Placeholder="Nom de famille"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Surname)" /></span>
                                                </span>
                                            </td>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfDatePicker TValue="DateTime"
                                                                  Placeholder="Anniversaire"
                                                                  @bind-Value="@_editModel.Birthday"
                                                                  FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Birthday)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="c-table">
                                    <tbody>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfDropDownList TItem="MemberTypeDto" TValue="Guid"
                                                                    @bind-Value="@_editModel.MemberTypeId"
                                                                    DataSource="@_memberTypes"
                                                                    Placeholder="Type de membre"
                                                                    FloatLabelType="FloatLabelType.Always">
                                                        <DropDownListFieldSettings Value="Id" Text="Name" />
                                                    </SfDropDownList>
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.MemberTypeId)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="c-table">
                                    <tbody>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfDropDownList TItem="AgeGroupDto" TValue="Guid"
                                                                    @bind-Value="@_editModel.AgeGroupId"
                                                                    DataSource="@_ageGroups"
                                                                    Placeholder="Tranche d'âge"
                                                                    FloatLabelType="FloatLabelType.Always">
                                                        <DropDownListFieldSettings Value="Id" Text="GroupName" />
                                                    </SfDropDownList>
                                                </div>
                                                <span>
                                                    <span><ValidationMessage For="@(() => _editModel.AgeGroupId)" /></span>
                                                </span>
                                            </td>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfDropDownList TItem="Gender" TValue="bool"
                                                                    @bind-Value="@_editModel.Gender"
                                                                    DataSource="@_genders"
                                                                    Placeholder="Genre"
                                                                    FloatLabelType="FloatLabelType.Always">
                                                        <DropDownListFieldSettings Value="Sex" Text="Name" />
                                                    </SfDropDownList>
                                                </div>
                                                <span>
                                                    <span><ValidationMessage For="@(() => _editModel.Gender)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Country"
                                                               Placeholder="Pays"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Country)" /></span>
                                                </span>
                                            </td>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Town"
                                                               Placeholder="Ville"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Town)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="c-table">
                                    <tbody>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Suburb"
                                                               Placeholder="Suburb"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Suburb)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Address"
                                                               Placeholder="Address"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Address)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="e-rowcell">
                                                <div>
                                                    <SfTextBox @bind-Value="@_editModel.Note"
                                                               Placeholder="Note"
                                                               Multiline="true"
                                                               Width="100%"
                                                               CssClass="transact-desc-textbox"
                                                               FloatLabelType="FloatLabelType.Always" />
                                                </div>
                                                <span class="c-err-msg">
                                                    <span><ValidationMessage For="@(() => _editModel.Note)" /></span>
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </EditForm>
                        </div>
                    </Content>
                </DialogTemplates>

                <DialogButtons>
                    <DialogButton form="@_formId"
                                  Type="Syncfusion.Blazor.Popups.ButtonType.Submit"
                                  IsPrimary="true" Disabled="@_isSaving" Content="@(_isSaving ? "Chargement..." : _buttonContent)" />

                    <DialogButton Type="Syncfusion.Blazor.Popups.ButtonType.Button"
                                  Content="Cancel" Disabled="@_isSaving" IsPrimary="true" OnClick="OnClickCancel" />
                </DialogButtons>

                @* <DialogEvents Created="OnCreate"></DialogEvents> *@
            </SfDialog>
        }
    </div>
</div>

